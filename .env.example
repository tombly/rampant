# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Anthropic API key for the Claude Code subprocess ("hands"). Create a dedicated key at
# console.anthropic.com (never reuse Ancela's), and set a hard spend cap/alert on it before
# starting the container. See PLAN.md -> Guardrails.
ANTHROPIC_API_KEY=

# Per-cycle guardrails on the claude -p invocation (see PLAN.md -> Guardrails). Optional - the
# agent runs with sensible defaults (30-40 turns, no budget cap) if these are left blank.
RAMPANT_MAX_BUDGET_USD=
RAMPANT_MAX_TURNS=

# Signal phone number for the signal-cli sidecar (E.164 format, e.g. +15551234567) - the only
# interaction channel (replaced an earlier Azure Storage Queue mailbox design; see PLAN.md ->
# "Opening holes" -> Signal). Must be a number dedicated to Rampant, never the owner's own Signal
# account - registering it here would deauthorize whatever currently owns that number's session.
# One-time setup after picking a number:
#   docker compose run --rm signal-cli register --voice   (or omit --voice for an SMS code)
#   docker compose run --rm signal-cli verify <code-received-on-the-phone>
# Only then does `docker compose up` bring up a working daemon.
SIGNAL_PHONE_NUMBER=

# Owner's Signal identifier (phone number or account UUID - either works as a "recipient", see
# Rampant.Supervisor/SignalNotifier.cs) for proactive supervisor alerts (build failures, unexpected
# crashes) - a separate, one-way channel from the agent's own conversation, since the supervisor
# never listens for or reacts to inbound messages. Optional - alerts are silently skipped if unset.
RAMPANT_OWNER_SIGNAL_ID=
