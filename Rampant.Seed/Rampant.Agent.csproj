<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Rampant.Agent</RootNamespace>
    <AssemblyName>Rampant.Agent</AssemblyName>
    <!-- Every package version is declared inline here, and must stay that way: SeedBootstrap
         copies this directory out into its own independent git repo on first boot, after which
         nothing above it is an ancestor anymore. This repo no longer uses central package
         management at all, so the belt-and-braces opt-out below is only insurance against someone
         reintroducing a Directory.Packages.props later - the failure it prevents is a
         container-only NU1015 that builds fine on a laptop. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- A provider-neutral chat abstraction and nothing more. Deliberately not a framework with
         built-in web search, memory, or code execution: every capability this agent has should be
         one it noticed it needed and asked for, and a batteries-included library makes it
         impossible to tell what it actually built from what it was handed. See ChatClientFactory. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3" />
  </ItemGroup>

</Project>
